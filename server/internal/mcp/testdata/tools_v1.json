  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Host metrics"
    },
    "description": "Get the history of metrics of one host, of many hosts or of a tag: min, avg, max, last and a capped list of points for each metric. Any history metric works (see reference). With compare, each metric also has the window before the range and the change of the average. The plan can shorten the range (clamped).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "compare": {
          "description": "also read the window of the same length before the range. Each series then has previous and change_avg, and the biggest change comes first.",
          "type": "boolean"
        },
        "from": {
          "description": "start of the range in RFC 3339. Use it with to, instead of range.",
          "type": "string"
        },
        "host": {
          "description": "one host, by ID or name. Give one of host, hosts or tag.",
          "type": "string"
        },
        "hosts": {
          "description": "at most 50 hosts, by ID or name",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "metrics": {
          "description": "history metrics to read: cpu, mem, net_rx, net_tx, disk_read, disk_write, load_1, load (the same as load_1), procs, disk, inodes, zombies, pids, files, psi_cpu, psi_mem, psi_mem_full, psi_io, psi_io_full and mem_pressure. At most 16 for one host and 8 for many hosts. Default cpu. Call reference with topic metrics for the units.",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "range": {
          "description": "span up to now, 15m to 365d (30d for many hosts), for example 1h, 24h or 7d. Default 1h. Do not use with from.",
          "type": "string"
        },
        "resolution": {
          "description": "auto, raw, 1m, 5m or 1h. Default auto. The server raises the step to keep at most 300 points.",
          "type": "string"
        },
        "tag": {
          "description": "all hosts with this tag, at most 50",
          "type": "string"
        },
        "to": {
          "description": "end of the range in RFC 3339. Default now.",
          "type": "string"
        }
      },
      "type": "object"
    },

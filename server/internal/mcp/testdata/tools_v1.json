  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Host metrics"
    },
    "description": "Get the history of metrics of one host: min, avg, max, last, and at most 300 points for each metric. The plan can shorten the range (clamped).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "start of the range in RFC 3339. Use it with to, instead of range.",
          "type": "string"
        },
        "host": {
          "description": "host ID or name",
          "type": "string"
        },
        "metrics": {
          "description": "metrics to read, at most 6: cpu (percent), mem (ratio 0 to 1), net_rx and net_tx (bytes each second), disk_read and disk_write (bytes each second). Default cpu.",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "range": {
          "description": "span up to now, 15m to 365d, for example 1h, 24h or 7d. Default 1h. Do not use with from.",
          "type": "string"
        },
        "resolution": {
          "description": "auto, raw, 1m, 5m or 1h. Default auto. The server raises the step to keep at most 300 points.",
          "type": "string"
        },
        "to": {
          "description": "end of the range in RFC 3339. Default now.",
          "type": "string"
        }
      },
      "required": [
        "host"
      ],
      "type": "object"
    },
    "name": "host_metrics",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "clamped": {

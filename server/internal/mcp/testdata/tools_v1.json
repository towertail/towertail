        },
        "from": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "host_id": {
          "type": "string"
        },
        "metrics": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "avg": {
                "type": "number"
              },
              "count": {
                "type": "integer"
              },
              "last": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "metric": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "points": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "max": {
                      "type": "number"
                    },
                    "ts": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "ts",
                    "value"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "resolution": {
                "type": "string"
              }
            },
            "required": [
              "metric",
              "resolution",
              "count",
              "min",
              "avg",
              "max",
              "last",
              "points"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "host",
        "host_id",
        "from",
        "to",
        "metrics"
      ],
      "type": "object"
    },
    "title": "Host metrics"
  },

  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Top processes"
    },
    "description": "Get the top processes of one host, or of the fleet, by CPU, memory or disk I/O over a range. With at and a host, get the processes at one time, with PID, user and state. Each process has its start time and run time where known.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "description": "one point in time instead of a range: RFC 3339, now or now-\u003cspan\u003e, for example now-2h. Needs host. Gives PID, user and state for a time in the last hour.",
          "type": "string"
        },
        "by": {
          "description": "order: cpu (average CPU), mem (peak memory) or io (average disk I/O). Default cpu.",
          "type": "string"
        },
        "from": {
          "description": "start of the range in RFC 3339. Use it with to, instead of range.",
          "type": "string"
        },
        "host": {
          "description": "host ID or name. Empty means the whole fleet.",
          "type": "string"
        },
        "limit": {
          "description": "most processes to return, 1 to 50. Default 20.",
          "type": "integer"
        },
        "range": {
          "description": "span up to now, 15m to 365d, for example 1h, 24h or 7d. Default 1h. Do not use with from or at.",
          "type": "string"
        },
        "to": {
          "description": "end of the range in RFC 3339. Default now.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "top_processes",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "clamped": {
          "type": "boolean"
        },
        "from": {
          "type": "string"
        },
        "processes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string"
              },
              "cpu_pct_avg": {
                "type": "number"
              },
              "cpu_pct_max": {
                "type": "number"
              },
              "first_seen": {
                "type": "string"
              },
              "host": {
                "type": "string"
              },
              "host_id": {
                "type": "string"
              },
              "io_bps_avg": {
                "type": "number"
              },

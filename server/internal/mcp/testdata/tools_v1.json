  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Process history"
    },
    "description": "Get the history of one process of a host: CPU, memory and disk I/O points, the stats of the range, the facts (PID, user, ports) and the start time. The process is a key from top_processes or a name.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "start of the range in RFC 3339. Use it with to, instead of range.",
          "type": "string"
        },
        "host": {
          "description": "host ID or name",
          "type": "string"
        },
        "process": {
          "description": "the key of a process from top_processes, or a process name. A name that has more than one command gives an error with the keys.",
          "type": "string"
        },
        "range": {
          "description": "span up to now, 15m to 365d, for example 1h, 24h or 7d. Default 1h. Do not use with from.",
          "type": "string"
        },
        "to": {
          "description": "end of the range in RFC 3339. Default now.",
          "type": "string"
        }
      },

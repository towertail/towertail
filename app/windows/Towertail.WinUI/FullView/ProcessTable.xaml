<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.FullView.ProcessTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <Grid Grid.Row="0" ColumnDefinitions="60,60,180,60,100,80,80" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Text="PID"     FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="PPID"    FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="NAME"    FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="CPU%"    FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="RSS"     FontWeight="SemiBold" />
            <TextBlock Grid.Column="5" Text="THREADS" FontWeight="SemiBold" />
            <TextBlock Grid.Column="6" Text="USER"    FontWeight="SemiBold" />
        </Grid>
        <ListView Grid.Row="1" x:Name="Items" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="60,60,180,60,100,80,80" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="{Binding Pid}" />
                        <TextBlock Grid.Column="1" Text="{Binding Ppid}" />
                        <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding CpuPct}" />
                        <TextBlock Grid.Column="4" Text="{Binding Rss}" />
                        <TextBlock Grid.Column="5" Text="{Binding Threads}" />
                        <TextBlock Grid.Column="6" Text="{Binding User}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Cards.DiskBars"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl x:Name="Items">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="80,*,60" ColumnSpacing="6" Margin="0,2,0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Mount}" FontSize="11" />
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Frac}" Height="6" />
                    <TextBlock Grid.Column="2" Text="{Binding Frac, Converter={StaticResource PercentFormat}}" FontSize="11" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

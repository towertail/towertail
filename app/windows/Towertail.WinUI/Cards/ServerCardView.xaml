<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Cards.ServerCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:Towertail.WinUI.Cards"
    xmlns:design="using:Towertail.WinUI.Design"
    xmlns:state="using:Towertail.WinUI.State">

    <UserControl.Resources>
        <design:PercentFormatConverter x:Key="PercentFormat" />
        <design:MBpsFormatConverter x:Key="MBpsFormat" />
        <Style x:Key="CardIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2,4,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,8,10,8"
            Tapped="OnCardTapped">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="0">
                    <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="HostText" FontSize="11" Opacity="0.7" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center" Margin="4,0,6,0">
                    <Button x:Name="TerminalBtn" Style="{StaticResource CardIconButtonStyle}"
                            Click="OnTerminalClick" Tapped="OnActionTapped"
                            ToolTipService.ToolTip="Open SSH terminal">
                        <FontIcon Glyph="&#xE756;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <Button x:Name="SettingsBtn" Style="{StaticResource CardIconButtonStyle}"
                            Click="OnSettingsClick" Tapped="OnActionTapped"
                            ToolTipService.ToolTip="Edit server">
                        <FontIcon Glyph="&#xE713;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <Button x:Name="FavoriteBtn" Style="{StaticResource CardIconButtonStyle}"
                            Click="OnFavoriteClick" Tapped="OnActionTapped"
                            ToolTipService.ToolTip="Favorite">
                        <FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="LastSeenText" FontSize="11" Opacity="0.7"
                           VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <cards:MetricCell Grid.Column="0" x:Name="CpuCell" Label="CPU" />
                <cards:MetricCell Grid.Column="1" x:Name="MemCell" Label="MEM" />
                <cards:MetricCell Grid.Column="2" x:Name="DiskCell" Label="DISK" />
                <cards:MetricCell Grid.Column="3" x:Name="NetCell" Label="NET" />
            </Grid>
            <TextBlock Grid.Row="2" x:Name="HealthText" FontSize="11" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                       Tapped="OnHealthTapped" />
        </Grid>
    </Border>
</UserControl>

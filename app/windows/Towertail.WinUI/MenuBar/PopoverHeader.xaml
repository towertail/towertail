<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.MenuBar.PopoverHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnDefinitions="*,Auto" Padding="12,8,12,8">
        <TextBlock Grid.Column="0" Text="Towertail" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button x:Name="PreferencesButton" Click="OnPreferencesClick" Content="⚙" FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>

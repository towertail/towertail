<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.MenuBar.PopoverHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,0">
        <TextBlock Grid.Column="0" Text="Towertail" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button x:Name="PreferencesButton" Click="OnPreferencesClick"
                    ToolTipService.ToolTip="Preferences"
                    Background="Transparent" BorderThickness="0" Padding="6,2,6,2"
                    Content="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="14" />
            <Button x:Name="CloseButton" Click="OnCloseClick"
                    ToolTipService.ToolTip="Close"
                    Background="Transparent" BorderThickness="0" Padding="6,2,6,2"
                    Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.MenuBar.PopoverRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:Towertail.WinUI.Cards"
    xmlns:state="using:Towertail.WinUI.State">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12,12,12,12" RowSpacing="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <TextBlock Grid.Row="0" Text="Towertail" FontSize="16" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" PlaceholderText="Search..." Width="200" TextChanged="OnSearchChanged" />
            <ComboBox x:Name="FilterBox" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                <ComboBoxItem>All</ComboBoxItem>
                <ComboBoxItem>Online</ComboBoxItem>
                <ComboBoxItem>Warn</ComboBoxItem>
                <ComboBoxItem>Down</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="Repeater" ItemsSource="{x:Bind FilteredServers}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="state:ServerViewModel">
                        <cards:ServerCardView ViewModel="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>

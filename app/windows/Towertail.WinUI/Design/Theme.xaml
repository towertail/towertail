<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="NominalColor">#4CAF50</Color>
    <Color x:Key="WarnColor">#FFC107</Color>
    <Color x:Key="CriticalColor">#F44336</Color>
    <Color x:Key="MutedColor">#888A91</Color>

    <SolidColorBrush x:Key="NominalBrush" Color="{StaticResource NominalColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />

    <Thickness x:Key="CardPadding">12,10,12,10</Thickness>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
</ResourceDictionary>

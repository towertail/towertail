<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Preferences.GeneralPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SettingsRowGrid" TargetType="Grid">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="16,12,16,12" />
        </Style>
        <Style x:Key="SettingsRowBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel MaxWidth="860" Spacing="4">

            <TextBlock Text="Startup" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,0,0,6" />

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Launch at startup" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Start Towertail when you sign in to Windows."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="LaunchAtStartupSwitch" Toggled="OnLaunchChanged" />
                </Grid>
            </Border>

            <TextBlock Text="Polling" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xE895;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Local poll interval" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="How often the local sampler runs on this machine (seconds)."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <NumberBox Grid.Column="2" x:Name="LocalPollBox" Minimum="1" Maximum="300"
                               SpinButtonPlacementMode="Inline" ValueChanged="OnLocalPollChanged" Width="140" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xE968;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SSH poll interval" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="How often remote samplers stream samples (seconds)."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <NumberBox Grid.Column="2" x:Name="SshPollBox" Minimum="1" Maximum="300"
                               SpinButtonPlacementMode="Inline" ValueChanged="OnSshPollChanged" Width="140" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xE708;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Post-wake grace" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Seconds to ignore after resuming from sleep before alerting."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <NumberBox Grid.Column="2" x:Name="GraceBox" Minimum="0" Maximum="300"
                               SpinButtonPlacementMode="Inline" ValueChanged="OnGraceChanged" Width="140" />
                </Grid>
            </Border>

            <TextBlock Text="Samplers" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xE895;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Auto-update remote samplers" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Upload newer sampler binaries when a remote is out of date."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="AutoUpdateSwitch" Toggled="OnAutoUpdateChanged" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

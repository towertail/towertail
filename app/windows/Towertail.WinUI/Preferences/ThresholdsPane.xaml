<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Preferences.ThresholdsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <TextBlock Text="Thresholds (0–1 fraction)" FontSize="18" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="160,120,120" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="" />
            <TextBlock Grid.Column="1" Text="Warn" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Critical" FontWeight="SemiBold" />
        </Grid>
        <Grid ColumnDefinitions="160,120,120" ColumnSpacing="12" RowSpacing="6">
            <TextBlock Text="CPU" VerticalAlignment="Center" Grid.Column="0" />
            <NumberBox x:Name="CpuWarnBox" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" />
            <NumberBox x:Name="CpuCritBox" Grid.Column="2" Minimum="0" Maximum="1" SmallChange="0.05" />
        </Grid>
        <Grid ColumnDefinitions="160,120,120" ColumnSpacing="12" RowSpacing="6">
            <TextBlock Text="MEM" VerticalAlignment="Center" Grid.Column="0" />
            <NumberBox x:Name="MemWarnBox" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" />
            <NumberBox x:Name="MemCritBox" Grid.Column="2" Minimum="0" Maximum="1" SmallChange="0.05" />
        </Grid>
        <Grid ColumnDefinitions="160,120,120" ColumnSpacing="12" RowSpacing="6">
            <TextBlock Text="DISK" VerticalAlignment="Center" Grid.Column="0" />
            <NumberBox x:Name="DiskWarnBox" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" />
            <NumberBox x:Name="DiskCritBox" Grid.Column="2" Minimum="0" Maximum="1" SmallChange="0.05" />
        </Grid>
        <Button x:Name="SaveBtn" Content="Save" Click="OnSaveClick" />
    </StackPanel>
</UserControl>

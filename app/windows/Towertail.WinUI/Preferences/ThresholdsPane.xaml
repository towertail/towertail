<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Preferences.ThresholdsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SettingsRowGrid" TargetType="Grid">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="16,12,16,12" />
        </Style>
        <Style x:Key="SettingsRowBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="ThresholdNumberBox" TargetType="NumberBox">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="5" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="SpinButtonPlacementMode" Value="Inline" />
            <Setter Property="Width" Value="170" />
        </Style>
        <Style x:Key="SustainNumberBox" TargetType="NumberBox">
            <Setter Property="Minimum" Value="1" />
            <Setter Property="Maximum" Value="30" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="5" />
            <Setter Property="SpinButtonPlacementMode" Value="Inline" />
            <Setter Property="Width" Value="120" />
        </Style>
        <Style x:Key="CountNumberBox" TargetType="NumberBox">
            <Setter Property="Minimum" Value="1" />
            <Setter Property="Maximum" Value="10000000" />
            <Setter Property="SmallChange" Value="100" />
            <Setter Property="LargeChange" Value="1000" />
            <Setter Property="SpinButtonPlacementMode" Value="Inline" />
            <Setter Property="Width" Value="170" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel MaxWidth="860" Spacing="4">

            <TextBlock Text="Alert thresholds" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,0,0,6" />
            <TextBlock Text="Values are percentages (0–100). Warn triggers a yellow state; Critical triggers red and a notification."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="1,0,0,12" TextWrapping="Wrap" />

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="CPU" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Warn %" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="CpuWarnBox" Style="{StaticResource ThresholdNumberBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Critical %" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="CpuCritBox" Style="{StaticResource ThresholdNumberBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0"
                                ToolTipService.ToolTip="Number of consecutive over-threshold samples required before this metric escalates. 1 = trigger immediately.">
                        <TextBlock Text="Sustain" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="CpuSustainBox" Style="{StaticResource SustainNumberBox}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xEEA0;" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Memory" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Warn %" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="MemWarnBox" Style="{StaticResource ThresholdNumberBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Critical %" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="MemCritBox" Style="{StaticResource ThresholdNumberBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0"
                                ToolTipService.ToolTip="Number of consecutive over-threshold samples required before this metric escalates. 1 = trigger immediately.">
                        <TextBlock Text="Sustain" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="MemSustainBox" Style="{StaticResource SustainNumberBox}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xEDA2;" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Disk" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Warn %" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="DiskWarnBox" Style="{StaticResource ThresholdNumberBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Critical %" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="DiskCritBox" Style="{StaticResource ThresholdNumberBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0"
                                ToolTipService.ToolTip="Number of consecutive over-threshold samples required before this metric escalates. 1 = trigger immediately.">
                        <TextBlock Text="Sustain" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="DiskSustainBox" Style="{StaticResource SustainNumberBox}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Host health" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,24,0,6" />
            <TextBlock Text="Counts of processes and zombie processes on the host."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="1,0,0,8" />
            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xE9F5;" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Processes" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Warn" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="ProcsWarnBox" Style="{StaticResource CountNumberBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Critical" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="ProcsCritBox" Style="{StaticResource CountNumberBox}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Zombies" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Warn" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="ZombiesWarnBox" Style="{StaticResource CountNumberBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Critical" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox x:Name="ZombiesCritBox" Style="{StaticResource CountNumberBox}" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="Also checked: PID use 70/90%, open files 80/95%, inodes 85/95%, memory pressure 10/20%, I/O pressure 20/40%."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="1,8,0,0" />

            <Button x:Name="SaveBtn" Content="Save" Click="OnSaveClick" Margin="0,12,0,0"
                    Style="{ThemeResource AccentButtonStyle}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>

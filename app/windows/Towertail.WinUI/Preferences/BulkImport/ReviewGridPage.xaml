<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Towertail.WinUI.Preferences.BulkImport.ReviewGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bi="using:Towertail.WinUI.Preferences.BulkImport">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <!-- Top controls -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" x:Name="ToggleAllBtn" Content="Select all" Click="OnToggleAll" />
            <AppBarSeparator Grid.Column="1" />
            <TextBlock Grid.Column="2" Text="Default SSH user:" VerticalAlignment="Center"
                       Style="{ThemeResource BodyTextBlockStyle}" />
            <TextBox Grid.Column="3" x:Name="BulkUserBox" Width="160" PlaceholderText="username" />
            <ComboBox Grid.Column="4" x:Name="ApplyScopeBox" Width="140" SelectedIndex="0">
                <ComboBoxItem Content="blanks only" />
                <ComboBoxItem Content="all rows" />
            </ComboBox>
            <Button Grid.Column="5" x:Name="ApplyBtn" Content="Apply to all" Click="OnApplyBulk" />
            <Button Grid.Column="7" x:Name="TestAllBtn" Content="Test all selected" Click="OnTestAll" />
        </Grid>

        <!-- Column header -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="6,6,0,0">
            <Grid Padding="8,6,8,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Name" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="Host / IP" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="SSH user" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="Kind" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="5" Text="Tags" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="6" Text="Status" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Rows -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,6,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bi:ImportRow">
                            <Grid Padding="8,4,8,4" ColumnSpacing="8"
                                  Opacity="{x:Bind Opacity, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" MinWidth="32"
                                          IsChecked="{x:Bind Included, Mode=TwoWay}"
                                          VerticalAlignment="Center" />

                                <TextBox Grid.Column="1" Text="{x:Bind DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBox Grid.Column="2" Text="{x:Bind SshHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}" />

                                <TextBox Grid.Column="3" Text="{x:Bind SshUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}"
                                         IsEnabled="{x:Bind IsSsh, Mode=OneWay}" />

                                <ComboBox Grid.Column="4" SelectedIndex="{x:Bind KindIndex, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="SSH" />
                                    <ComboBoxItem Content="Local" />
                                </ComboBox>

                                <TextBox Grid.Column="5" Text="{x:Bind TagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="tag1, tag2" />

                                <TextBlock Grid.Column="6" Text="{x:Bind StatusLabel, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{ThemeResource CaptionTextBlockStyle}" />

                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Click="OnTestRow" Tag="{x:Bind}" ToolTipService.ToolTip="Test">
                                        <FontIcon Glyph="&#xE945;" FontSize="14" />
                                    </Button>
                                    <Button Click="OnRemoveRow" Tag="{x:Bind}" ToolTipService.ToolTip="Remove">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" x:Name="FooterText"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>

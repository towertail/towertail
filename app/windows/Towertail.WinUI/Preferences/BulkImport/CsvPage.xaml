<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Towertail.WinUI.Preferences.BulkImport.CsvPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="CSV / TSV"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="PickBtn" Content="Choose File…" Click="OnPick" />
        </Grid>

        <TextBlock Grid.Row="1" x:Name="ErrorText"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Visibility="Collapsed" TextWrapping="Wrap" />

        <TextBlock Grid.Row="2" x:Name="FilenameText"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed" />

        <CheckBox Grid.Row="3" x:Name="HeaderCheck" Content="First row is a header"
                  IsChecked="True" Checked="OnHeaderChanged" Unchecked="OnHeaderChanged"
                  Visibility="Collapsed" />

        <ScrollViewer Grid.Row="4" x:Name="MappingScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Visibility="Collapsed">
            <StackPanel x:Name="MappingPanel" Orientation="Horizontal" Spacing="8" />
        </ScrollViewer>

        <Border Grid.Row="5" x:Name="PreviewBorder"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6"
                Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="8">
                <StackPanel x:Name="PreviewPanel" Spacing="2" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="5" x:Name="EmptyHint"
                   Text="Pick a .csv or .tsv file to begin."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>

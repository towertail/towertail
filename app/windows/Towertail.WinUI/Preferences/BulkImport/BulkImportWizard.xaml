<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Towertail.WinUI.Preferences.BulkImport.BulkImportWizard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <Frame Grid.Row="0" x:Name="Host" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,12,0,0">
            <Button x:Name="BackBtn" Content="Back" Click="OnBack" />
            <Button x:Name="NextBtn" Content="Next" Click="OnNext" />
        </StackPanel>
    </Grid>
</Window>

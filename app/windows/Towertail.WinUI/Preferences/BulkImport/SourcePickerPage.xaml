<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Towertail.WinUI.Preferences.BulkImport.SourcePickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12" Margin="12">
        <TextBlock Text="Import source" FontSize="18" FontWeight="SemiBold" />
        <RadioButton x:Name="TailscaleRadio" Content="From Tailscale peers" GroupName="src" IsChecked="True" />
        <RadioButton x:Name="PasteRadio" Content="Paste user@host list" GroupName="src" />
    </StackPanel>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Preferences.LogsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" MaxWidth="1200">
        <TextBlock Grid.Row="0" Text="Logs"
                   Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,0,0,6" />

        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16,12">
            <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
                <FontIcon Grid.Column="0" Glyph="&#xE8DA;" FontSize="20"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Log folder" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="PathText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Content="Open folder" Click="OnOpenFolder"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="0" Margin="0,4,0,0">
            <TextBox x:Name="Viewer" AcceptsReturn="True" IsReadOnly="True"
                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                     BorderThickness="0" Background="Transparent"
                     TextWrapping="NoWrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</UserControl>

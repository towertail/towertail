<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Preferences.LogsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Log file:" VerticalAlignment="Center" />
            <TextBlock x:Name="PathText" FontFamily="Consolas" />
            <Button Content="Open folder" Click="OnOpenFolder" />
        </StackPanel>
        <TextBox Grid.Row="1" x:Name="Viewer" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono" FontSize="11" />
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Preferences.NotificationsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SettingsRowGrid" TargetType="Grid">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="16,12,16,12" />
        </Style>
        <Style x:Key="SettingsRowBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel MaxWidth="860" Spacing="4">

            <TextBlock Text="Notifications" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,0,0,6" />

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xEA8F;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Enable notifications" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Show Windows toast notifications when hosts cross a threshold."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="EnabledSwitch" Toggled="OnEnabledChanged" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Notify on Warn" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Send a toast when a host enters the warning state."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="WarnSwitch" Toggled="OnWarnChanged" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xE783;" FontSize="18" VerticalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Notify on Critical" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Send a toast when a host enters the critical state."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="CriticalSwitch" Toggled="OnCriticalChanged" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowBorder}">
                <Grid Style="{StaticResource SettingsRowGrid}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Debounce" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Seconds to suppress duplicate notifications per host."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <NumberBox Grid.Column="2" x:Name="DebounceBox" Minimum="0" Maximum="3600"
                               SpinButtonPlacementMode="Inline" ValueChanged="OnDebounceChanged" Width="140" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

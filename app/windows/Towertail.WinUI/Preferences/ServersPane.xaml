<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Preferences.ServersPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <Button x:Name="AddBtn" Content="Add" Click="OnAddClick" />
            <Button x:Name="EditBtn" Content="Edit" Click="OnEditClick" />
            <Button x:Name="RemoveBtn" Content="Remove" Click="OnRemoveClick" />
            <Button x:Name="BulkBtn" Content="Bulk import…" Click="OnBulkClick" />
        </StackPanel>
        <ListView Grid.Row="1" x:Name="Items" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="200,160,120,*" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" />
                        <TextBlock Grid.Column="1" Text="{Binding UserAtHost}" />
                        <TextBlock Grid.Column="2" Text="{Binding Kind}" />
                        <TextBlock Grid.Column="3" Text="{Binding Enabled}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

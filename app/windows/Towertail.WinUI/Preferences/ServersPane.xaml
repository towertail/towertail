<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Preferences.ServersPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="Servers"
                   Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,0,0,0" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
            <Button x:Name="AddBtn" Click="OnAddClick"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="Add" />
                </StackPanel>
            </Button>
            <Button x:Name="EditBtn" Click="OnEditClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                    <TextBlock Text="Edit" />
                </StackPanel>
            </Button>
            <Button x:Name="RemoveBtn" Click="OnRemoveClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    <TextBlock Text="Remove" />
                </StackPanel>
            </Button>
            <AppBarSeparator />
            <Button x:Name="BulkBtn" Click="OnBulkClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8B5;" FontSize="12" />
                    <TextBlock Text="Bulk import…" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" Padding="16,10,16,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" MinWidth="60" />
                        <ColumnDefinition Width="3*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" MinWidth="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Kind" TextWrapping="NoWrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Host"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Enabled" TextWrapping="NoWrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Border Grid.Row="1" Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ListView Grid.Row="2" x:Name="Items" SelectionMode="Single"
                          Padding="8,4,8,8" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,8,8,8" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="MinHeight" Value="40" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="120" />
                                    <ColumnDefinition Width="Auto" MinWidth="60" />
                                    <ColumnDefinition Width="3*" MinWidth="140" />
                                    <ColumnDefinition Width="Auto" MinWidth="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Kind}" TextWrapping="NoWrap"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding UserAtHost}"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontFamily="{StaticResource MonoFont}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Enabled}" TextWrapping="NoWrap"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="4" Margin="1,4,1,0">
            <CheckBox x:Name="AutoUpdateCheck" Content="Auto-update remote samplers"
                      Checked="OnAutoUpdateChanged" Unchecked="OnAutoUpdateChanged" />
            <TextBlock TextWrapping="Wrap"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                SSH nodes require the sampler at ~/.towertail/towertail-sampler on the remote host.
                When enabled, Towertail silently uploads the bundled sampler binary to any SSH host
                running an older build. Off by default — turn on only after verifying Test works for
                your hosts.
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.FullView.ProcessTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fv="using:Towertail.WinUI.FullView">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Grid Grid.Row="0" Padding="16,10,16,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TOP PROCESSES" VerticalAlignment="Center" FontSize="11"
                           CharacterSpacing="80" FontFamily="{StaticResource MonoFont}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="WhenText" VerticalAlignment="Center" FontSize="12"
                           FontFamily="{StaticResource MonoFont}" />
                <Border Grid.Column="2" x:Name="LivePill" CornerRadius="10" Padding="8,1,8,2" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="live" FontSize="11" FontFamily="{StaticResource MonoFont}" x:Name="LiveText" />
                </Border>
                <ContentPresenter Grid.Column="4" x:Name="SortHost" />
            </Grid>
            <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <ProgressBar Grid.Row="1" x:Name="LoadBar" IsIndeterminate="True" Visibility="Collapsed"
                         Height="2" MinHeight="2" VerticalAlignment="Top" />
            <Grid Grid.Row="2" Padding="24,8,24,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="PID" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="Process" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="User" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="CPU %" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="Memory" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="5" Text="I/O" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="6" Text="Threads" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="7" Text="Started" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <TextBlock Grid.Row="3" x:Name="SkippedText" Visibility="Collapsed"
                       Margin="16,12,16,12" TextWrapping="Wrap"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView Grid.Row="3" x:Name="Items" SelectionMode="Single"
                      Padding="8,0,8,4" Background="Transparent"
                      SelectionChanged="OnSelectionChanged" RightTapped="OnRightTapped">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="16,2,16,2" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="MinHeight" Value="30" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="fv:ProcessRow">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <fv:PidCell Grid.Column="0" Pid="{x:Bind Pid}" Name="{x:Bind Name}"
                                        Visibility="{x:Bind PidVisibility}"
                                        CanKill="{x:Bind CanKill}" Killed="OnKillRequested" />
                            <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Cmd}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{x:Bind User}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2" Width="{x:Bind BarWidth}" VerticalAlignment="Center"
                                        Background="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="{x:Bind CpuText}" FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                            <TextBlock Grid.Column="4" Text="{x:Bind RssText}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{x:Bind IoText}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="6" Text="{x:Bind ThreadsText}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="7" Text="{x:Bind StartedText}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border Grid.Row="4" BorderThickness="0,1,0,0" Padding="16,6,16,6"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="CountText" FontSize="11" FontFamily="{StaticResource MonoFont}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" x:Name="RequestText" FontSize="11" FontFamily="{StaticResource MonoFont}"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="← → step when pinned" FontSize="11" FontFamily="{StaticResource MonoFont}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

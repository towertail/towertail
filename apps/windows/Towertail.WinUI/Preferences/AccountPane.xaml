<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Preferences.AccountPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prefs="using:Towertail.WinUI.Preferences">

    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="16,14,16,14" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel MaxWidth="860" Spacing="4">

            <TextBlock Text="Account" Style="{ThemeResource TitleTextBlockStyle}" Margin="1,0,0,14" />

            <!-- Signed out, and the code entry. -->
            <StackPanel x:Name="OutPanel" Spacing="4">
                <TextBlock Text="Sign in to Towertail Cloud"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,0,0,6" />
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Cloud keeps your hosts under watch while this PC is asleep."
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                <TextBox x:Name="EmailBox" Width="280" PlaceholderText="Email"
                                         AutomationProperties.Name="Email" InputScope="EmailSmtpAddress"
                                         TextChanged="OnEmailChanged" KeyDown="OnEmailKeyDown" />
                                <Button x:Name="SendBtn" Content="Email me a code" Click="OnSendClick"
                                        Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,14,0,0">
                                <TextBlock x:Name="SentText" Style="{StaticResource CaptionText}" />
                                <prefs:CodeEntryBox x:Name="Code" Margin="0,10,0,6" Completed="OnCodeCompleted" />
                                <HyperlinkButton x:Name="ResendBtn" Padding="0" FontSize="12" Click="OnResendClick" />
                            </StackPanel>
                            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="0,10,0,0"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Signed in. -->
            <StackPanel x:Name="InPanel" Spacing="4" Visibility="Collapsed">
                <TextBlock Text="Towertail Cloud"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,0,0,6" />
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <Grid Grid.Column="1" ColumnDefinitions="140,*" ColumnSpacing="16" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Email" Style="{StaticResource KeyText}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EmailValue" IsTextSelectionEnabled="True" />
                            <TextBlock Grid.Row="1" Text="Organization" Style="{StaticResource KeyText}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OrgValue" />
                            <TextBlock Grid.Row="2" Text="Plan" Style="{StaticResource KeyText}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PlanValue" />
                            <TextBlock Grid.Row="3" x:Name="HostsKey" Text="Cloud hosts" Style="{StaticResource KeyText}" />
                            <StackPanel Grid.Row="3" Grid.Column="1" x:Name="HostsRow" Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="HostsValue" VerticalAlignment="Center" />
                                <Button x:Name="MoveBtn" Content="Move hosts to Cloud…" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Text="SSH hosts" Style="{StaticResource KeyText}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SshValue" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <FontIcon Grid.Column="0" Glyph="&#xE8A7;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Dashboard" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Rules, channels, on call and billing are on the web." Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="DashboardBtn" Content="Open dashboard" Click="OnDashboardClick" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Sign out" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="LeavingRing" Width="14" Height="14" IsActive="False"
                                              Visibility="Collapsed" VerticalAlignment="Center" />
                                <TextBlock x:Name="SignOutNote" Style="{StaticResource CaptionText}"
                                           Text="The app moves your Cloud hosts back to SSH first." />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="SignOutBtn" Content="Sign out…" Click="OnSignOutClick" />
                    </Grid>
                </Border>

                <HyperlinkButton x:Name="DeleteBtn" Content="Delete Cloud account…" FontSize="12"
                                 Margin="0,10,0,0" Padding="2,0,0,0" Click="OnDeleteClick"
                                 Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>

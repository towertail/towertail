<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Towertail.WinUI.Preferences.CodeEntryBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid HorizontalAlignment="Left">
        <!-- One hidden field takes the keys and the paste. The cells only draw. -->
        <TextBox x:Name="Field" Width="1" Height="1" Opacity="0.01" MinWidth="0" MinHeight="0"
                 Padding="0" BorderThickness="0" InputScope="Number"
                 AutomationProperties.Name="Sign-in code"
                 TextChanged="OnTextChanged" GotFocus="OnFocusChanged" LostFocus="OnFocusChanged" />
        <StackPanel x:Name="Cells" Orientation="Horizontal" Spacing="8" Tapped="OnCellsTapped"
                    Background="Transparent" />
    </Grid>
</UserControl>

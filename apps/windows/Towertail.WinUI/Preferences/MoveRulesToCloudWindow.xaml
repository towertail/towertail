<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Towertail.WinUI.Preferences.MoveRulesToCloudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Padding="24,20,24,20" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />

        <StackPanel x:Name="LoadingPanel" Grid.Row="1" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing Width="16" Height="16" IsActive="True" />
            <TextBlock x:Name="LoadingText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid x:Name="ContentPanel" Grid.Row="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
            <TextBlock x:Name="LeadText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid x:Name="HeaderRow" ColumnSpacing="14" Padding="12,8,12,8" />
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel x:Name="Rows" IsHitTestVisible="True" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="FootText" Grid.Row="2" FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <StackPanel x:Name="ErrorRow" Grid.Row="3" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <StackPanel x:Name="SendingRow" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" VerticalAlignment="Center">
                <ProgressRing Width="14" Height="14" IsActive="True" />
                <TextBlock x:Name="SendingText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="NotNowBtn" Grid.Column="2" Content="Not now" Click="OnNotNow" />
            <Button x:Name="MoveBtn" Grid.Column="3" Style="{ThemeResource AccentButtonStyle}" Click="OnMoveClick" />
        </Grid>
    </Grid>
</Window>

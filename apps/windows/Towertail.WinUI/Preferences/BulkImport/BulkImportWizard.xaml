<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Towertail.WinUI.Preferences.BulkImport.BulkImportWizard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <!-- Stepper header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14"
                    Padding="20,14,20,14">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border x:Name="Step1Dot" Width="22" Height="22" CornerRadius="11"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="1" FontSize="12" FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step1Label" Text="Source" VerticalAlignment="Center" />
            </StackPanel>
            <Rectangle Width="28" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border x:Name="Step2Dot" Width="22" Height="22" CornerRadius="11"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="2" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step2Label" Text="Fetch" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Rectangle Width="28" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border x:Name="Step3Dot" Width="22" Height="22" CornerRadius="11"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="3" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step3Label" Text="Review" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Rectangle Width="28" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border x:Name="Step4Dot" Width="22" Height="22" CornerRadius="11"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="4" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step4Label" Text="Deploy" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Page host -->
        <Frame Grid.Row="2" x:Name="Host" Padding="20,12,20,12" />

        <Border Grid.Row="3" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Footer -->
        <Grid Grid.Row="4" Padding="20,12,20,14" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="CancelBtn" Content="Cancel" Click="OnCancel" />
                <Button x:Name="BackBtn" Content="Back" Click="OnBack" />
                <Button x:Name="NextBtn" Content="Next" Click="OnNext"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Towertail.WinUI.Preferences.BulkImport.PastePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="12" Spacing="8">
        <TextBlock Text="Paste user@host lines (one per line):" FontWeight="SemiBold" />
        <TextBox x:Name="InputBox" AcceptsReturn="True" Height="240" TextChanged="OnChanged" />
    </StackPanel>
</Page>

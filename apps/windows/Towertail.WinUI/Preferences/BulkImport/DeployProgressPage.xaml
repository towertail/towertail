<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Towertail.WinUI.Preferences.BulkImport.DeployProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bi="using:Towertail.WinUI.Preferences.BulkImport">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="12">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" x:Name="StatusText"
                       Text="Deploying…"
                       FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="Ring" IsActive="True" Width="16" Height="16" />
                <TextBlock x:Name="Counters" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Per-row progress -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bi:DeployRow">
                            <Grid Padding="12,6,12,6" ColumnSpacing="12"
                                  ColumnDefinitions="24,*,Auto">
                                <FontIcon Grid.Column="0"
                                          Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                                          Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                          FontSize="16"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind UserAtHost}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind StatusDetail, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="320" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>

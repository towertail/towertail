<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Towertail.WinUI.Preferences.BulkImport.SourcePickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="SourceTileButton" TargetType="Button">
            <Setter Property="Width" Value="260" />
            <Setter Property="Height" Value="160" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Page.Resources>

    <StackPanel Spacing="16">
        <TextBlock Text="Import servers from…"
                   FontSize="18" FontWeight="SemiBold" />

        <StackPanel Orientation="Horizontal" Spacing="14">
            <Button x:Name="TailscaleTile" Click="OnTailscale" Style="{StaticResource SourceTileButton}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <FontIcon Grid.Row="0" Glyph="&#xE968;" FontSize="26"
                              HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Grid.Row="1" Text="Tailscale"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Row="2"
                               Text="Auto-discover your tailnet peers."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                </Grid>
            </Button>

            <Button x:Name="CsvTile" Click="OnCsv" Style="{StaticResource SourceTileButton}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <FontIcon Grid.Row="0" Glyph="&#xE8A9;" FontSize="26"
                              HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Grid.Row="1" Text="CSV / TSV file"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Row="2"
                               Text="Import a spreadsheet or Ansible inventory export."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                </Grid>
            </Button>

            <Button x:Name="PasteTile" Click="OnPaste" Style="{StaticResource SourceTileButton}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <FontIcon Grid.Row="0" Glyph="&#xE8A5;" FontSize="26"
                              HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Grid.Row="1" Text="Paste list"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Row="2"
                               Text="One host per line, or user@host."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                </Grid>
            </Button>
        </StackPanel>
    </StackPanel>
</Page>

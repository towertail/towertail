<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Towertail.WinUI.Preferences.MoveToCloudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Padding="24,20,24,20" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="14">
        <TextBlock Text="Move hosts to Cloud" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="NoteText" Grid.Row="1" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid x:Name="HeaderRow" ColumnSpacing="10" Padding="10,8,10,8" />
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel x:Name="Rows" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="FootText" Grid.Row="3" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="NotNowBtn" Content="Not now" Click="OnNotNow" />
            <Button x:Name="MoveBtn" Style="{ThemeResource AccentButtonStyle}" Click="OnMoveClick" />
        </StackPanel>
    </Grid>
</Window>

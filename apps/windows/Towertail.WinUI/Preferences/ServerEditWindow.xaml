<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Towertail.WinUI.Preferences.ServerEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Towertail.WinUI.Preferences">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" Padding="20,16,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Stretch">
                <TextBlock x:Name="TitleText" Text="New Server" FontSize="18" FontWeight="SemiBold" />
                <TextBox x:Name="DisplayNameBox" Header="Name" PlaceholderText="my-server" />
                <ComboBox x:Name="KindBox" Header="Kind" HorizontalAlignment="Stretch" SelectionChanged="OnKindChanged">
                    <ComboBoxItem Content="Local (this PC)" />
                    <ComboBoxItem Content="SSH" />
                </ComboBox>
                <StackPanel x:Name="SshGroup" Spacing="10">
                    <TextBox x:Name="UserBox" Header="SSH user" />
                    <TextBox x:Name="HostBox" Header="SSH host" />
                    <NumberBox x:Name="PortBox" Header="Port" PlaceholderText="22"
                               Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline" />
                    <ComboBox x:Name="AuthMethodBox" Header="Login method" HorizontalAlignment="Stretch"
                              SelectionChanged="OnAuthMethodChanged">
                        <ComboBoxItem Content="SSH Key" />
                        <ComboBoxItem Content="Password" />
                    </ComboBox>
                    <PasswordBox x:Name="PasswordBoxField" Header="Password"
                                 Visibility="Collapsed" />
                    <HyperlinkButton x:Name="KeyHelpLink" Content="Need help setting up SSH keys?"
                                     Click="OnKeyHelp" />
                    <StackPanel x:Name="HostKeyPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Host key" VerticalAlignment="Center" Opacity="0.7" />
                        <TextBlock x:Name="HostKeyText" VerticalAlignment="Center"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                   MaxWidth="280" />
                        <Button x:Name="ForgetHostKeyBtn" Content="Forget"
                                Click="OnForgetHostKey"
                                ToolTipService.ToolTip="Clears the pinned fingerprint. The next connect will prompt again." />
                    </StackPanel>
                </StackPanel>
                <TextBox x:Name="TagsBox" Header="Tags (comma-separated)" PlaceholderText="prod, web, eu" />
                <CheckBox x:Name="EnabledCheck" Content="Enabled" />

                <TextBlock Text="Menu-bar icon" FontWeight="SemiBold" Margin="0,4,0,0" />
                <CheckBox x:Name="IconWarnCheck" Content="Color icon on warn" />
                <CheckBox x:Name="IconCriticalCheck" Content="Color icon on critical" />

                <TextBlock Text="Notifications" FontWeight="SemiBold" Margin="0,4,0,0" />
                <CheckBox x:Name="NotifyWarnCheck" Content="Notify at warn threshold" />
                <CheckBox x:Name="NotifyCriticalCheck" Content="Notify at critical threshold" />

                <TextBlock Text="Thresholds" FontWeight="SemiBold" Margin="0,4,0,0" />
                <CheckBox x:Name="CustomThresholdsCheck" Content="Customize thresholds for this server" Checked="OnCustomToggled" Unchecked="OnCustomToggled" />

                <StackPanel x:Name="ThresholdsGroup" Spacing="6">
                    <TextBlock Text="CPU" FontSize="12" Opacity="0.7" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Warn" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" x:Name="CpuWarnSlider" Minimum="10" Maximum="99" />
                        <TextBlock Grid.Column="2" x:Name="CpuWarnValue" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Critical" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" x:Name="CpuCriticalSlider" Minimum="10" Maximum="99" />
                        <TextBlock Grid.Column="2" x:Name="CpuCriticalValue" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="Memory" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Warn" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" x:Name="MemWarnSlider" Minimum="10" Maximum="99" />
                        <TextBlock Grid.Column="2" x:Name="MemWarnValue" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Critical" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" x:Name="MemCriticalSlider" Minimum="10" Maximum="99" />
                        <TextBlock Grid.Column="2" x:Name="MemCriticalValue" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="Disk" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Warn" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" x:Name="DiskWarnSlider" Minimum="10" Maximum="99" />
                        <TextBlock Grid.Column="2" x:Name="DiskWarnValue" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Critical" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" x:Name="DiskCriticalSlider" Minimum="10" Maximum="99" />
                        <TextBlock Grid.Column="2" x:Name="DiskCriticalValue" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="Alerting" FontWeight="SemiBold" Margin="0,4,0,0" />
                <CheckBox x:Name="CustomAlertsCheck" Content="Customize alerting for this server"
                          Checked="OnCustomAlertsToggled" Unchecked="OnCustomAlertsToggled"
                          ToolTipService.ToolTip="When off, this server uses the global alerting rules from the Thresholds tab." />
                <local:AlertRulesEditor x:Name="AlertsEditor" IsEnabled="False" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Padding="20,12,20,16">
            <Button x:Name="CancelBtn" Content="Cancel" Click="OnCancel" />
            <Button x:Name="OkBtn" Content="Save" Click="OnOk"
                    Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
